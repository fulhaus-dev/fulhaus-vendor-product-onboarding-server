{
  "name": "fulhaus-vendor-product-onboarding-webhook",
  "version": "1.0.0",
  "description": "Fülhaus Vendor Product Onboarding Webhook",
  "type": "module",
  "main": "dist/webhook.js",
  "engines": {
    "node": "22",
    "pnpm": "10"
  },
  "scripts": {
    "dev": "tsx watch src/webhook.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/webhook.js",
    "prepare": "(test -d .git && lefthook install) || echo 'No git repository, skipping lefthook'",
    "format": "biome format --write ./src",
    "lint": "biome lint ./src",
    "lint:fix": "biome check --apply ./src",
    "ci": "biome ci ./src",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "check": "tsc --noEmit",
    "test": "echo \"Error: no test specified yet\" && exit 0",
    "ps": "npx tree-cli . -l 3 --ignore=\"node_modules,.git,dist,build,coverage,*.log,*.lock,*.env\" --dirs-first -o project-structure.md && echo \"Project structure saved to PROJECT.STRUCTURE.md\""
  },
  "keywords": [
    "Fülhaus",
    "Fulhaus",
    "Product Onboarding",
    "node",
    "express",
    "typescript",
    "webhook",
    "api"
  ],
  "author": "Uneku Idumajogu",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "morgan": "^1.10.1",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.0",
    "lefthook": "^2.0.2",
    "pino-pretty": "^13.1.2",
    "rimraf": "^6.1.0",
    "tree-cli": "^0.6.7",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
